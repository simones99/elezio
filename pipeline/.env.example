# Configurazione locale della pipeline. Copia in pipeline/.env (ignorato da git)
# e compila. Le variabili sovrascrivono pipeline.toml (vedi docs/pipeline.md).

# Endpoint compatibile OpenAI. Default: OpenRouter, per controllare traffico e
# tetto di spesa per chiave.
ELEZIO_LLM_BASE_URL=https://openrouter.ai/api/v1
# Chiave OpenRouter (sk-or-...). Vuota: passi 5 e 6 disattivati.
ELEZIO_LLM_API_KEY=
# Su OpenRouter blocca i modelli Mistral sul provider mistral, senza fallback.
ELEZIO_LLM_PROVIDER=mistral

ELEZIO_MODELLO_SINTESI=mistralai/mistral-large-4-0
ELEZIO_MODELLO_CLASSIFICAZIONE=mistralai/ministral-14b-2512

# OCR delle scansioni: mistral-ocr (con la chiave, plugin file-parser di
# OpenRouter) oppure tesseract (immagine Docker in pipeline/docker/tesseract).
ELEZIO_OCR=mistral-ocr

ELEZIO_CLASSIFICATORE=llm
ELEZIO_JEV_API_KEY=
# Tetto di spesa per run, in dollari: oltre si ferma.
ELEZIO_TETTO_DOLLARI=30
ELEZIO_SOGLIA_CLASSIFICAZIONE=0.1

# Clone locale del repo privato elezio-fonti (PDF, testi estratti, lavoro).
# Default: la cartella elezio-fonti accanto al repo elezio.
ELEZIO_FONTI=
